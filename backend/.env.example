# Product Detective — Environment Variables
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=change-me-to-something-secure-in-production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=product_detective

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT=30
MAX_REVIEWS_PER_PRODUCT=500

# ── ML Models ────────────────────────────────────────────────────────────────
ML_MODEL_PATH=./ml/saved_models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
BATCH_SIZE=32

# ── Investigation Thresholds ─────────────────────────────────────────────────
MIN_REVIEWS_REQUIRED=20
COMPLAINT_THRESHOLD=0.15
BUY_THRESHOLD=0.68
WAIT_THRESHOLD=0.44
TREND_MONTHS_LOOKBACK=6

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PRO_PLAN_AMOUNT=9900
RAZORPAY_CURRENCY=INR
